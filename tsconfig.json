{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/components/assessment",
    "src/components/certificate",
    "src/components/dashboard/ai-learning-plan.tsx",
    "src/components/dashboard/learning-intelligence.tsx",
    "src/components/journey",
    "src/components/mentor",
    "src/components/preferences",
    "src/components/project",
    "src/components/skills",
    "src/components/workspace",
    "src/components/shared/journey-progress-header.tsx",
    "src/components/shared/skill-bars.tsx",
    "src/lib/mock",
    "src/lib/workspace"
  ]
}
