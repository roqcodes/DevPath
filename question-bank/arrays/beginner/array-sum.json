  "hints": [{ "order": 1, "text": "Read n, then accumulate in a loop." }],
  "editorial": "Single pass O(n) time, O(1) extra space.",
  "complexity": { "time": "O(n)", "space": "O(1)" },
  "reference_solutions": {
    "python": "import sys\nlines = sys.stdin.read().strip().split()\nn = int(lines[0])\nnums = list(map(int, lines[1:1+n]))\nprint(sum(nums))\n"
