  "statement": "Print the maximum sum of any contiguous subarray.",
  "io_format": {
    "mode": "stdin_stdout",
    "input_description": "Line 1: n. Line 2: n integers.",
    "output_description": "Maximum subarray sum."
  },
  "constraints": ["1 <= n <= 10^5"],
  "examples": [{ "input": "9\n-2 1 -3 4 -1 2 1 -5 4", "output": "6" }],
  "execution": {
    "time_limit_ms": 2000,
