  "test_cases": [
    { "id": "pub-1", "is_public": true, "input": "9\n-2 1 -3 4 -1 2 1 -5 4", "expected_output": "6" },
    { "id": "hid-1", "is_public": false, "input": "1\n-1000", "expected_output": "-1000" }
  ],
  "hints": [{ "order": 1, "text": "Kadane: best ending here vs start fresh." }],
  "complexity": { "time": "O(n)", "space": "O(1)" },
  "reference_solutions": {
    "python": "import sys\ndata = sys.stdin.read().strip().split()\nn = int(data[0])\nnums = list(map(int, data[1:1+n]))\nbest = cur = nums[0]\nfor x in nums[1:]:\n    cur = max(x, cur+x)\n    best = max(best, cur)\nprint(best)\n"
  }
