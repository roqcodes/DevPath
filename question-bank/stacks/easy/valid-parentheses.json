  "schema_version": "2.0.0",
  "id": "valid-parentheses",
  "slug": "valid-parentheses",
  "title": "Valid Parentheses",
  "difficulty": { "label": "easy", "score": 320 },
  "topics": ["stacks", "strings"],
  "status": "published",
  "revision": 1,
  "estimated_minutes": 20,
  "provenance": { "author": "SAIT DSA", "license": "CC-BY-4.0", "source": "original" },
  "statement": "Given a bracket string with ()[]{} , print true if valid, else false.",
  "io_format": {
    "mode": "stdin_stdout",
    "input_description": "Single line bracket string.",
    "output_description": "true or false"
  },
  "constraints": ["1 <= length <= 10000"],
  "examples": [{ "input": "()[]{}", "output": "true" }],
  "execution": {
    "time_limit_ms": 1000,
    "memory_limit_kb": 131072,
    "comparison": "trimmed",
    "languages": ["python"]
  },
  "test_cases": [
    { "id": "pub-1", "is_public": true, "input": "()[]{}", "expected_output": "true" },
    { "id": "pub-2", "is_public": true, "input": "(]", "expected_output": "false" },
    { "id": "hid-1", "is_public": false, "input": "([{}])", "expected_output": "true" }
  ],
  "hints": [{ "order": 1, "text": "Use a stack of opening brackets." }],
  "complexity": { "time": "O(n)", "space": "O(n)" },
  "reference_solutions": {
    "python": "s = input().strip()\nstack = []\npairs = {')':'(', ']':'[', '}':'{'}\nfor ch in s:\n    if ch in '([{':\n        stack.append(ch)\n    elif not stack or stack.pop() != pairs[ch]:\n        print('false')\n        exit()\nprint('true' if not stack else 'false')\n"
  }
}
