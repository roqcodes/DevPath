# Supabase (optional — omit all three for zero-config demo; engine stays in localStorage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Demo without accounts: bypass auth on protected routes (also works with no Supabase env)
# NEXT_PUBLIC_DEVPATH_DEMO=1
# Or visit any protected route with ?demo=1 to set the devpath_demo=1 cookie for 30 days

# OpenRouter — lesson AI guide (server only)
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Default below uses OpenRouter's free model router ($0). Or pick a specific free model, e.g. meta-llama/llama-4-maverick:free
OPENROUTER_MODEL=openrouter/free

# Public site URL (OpenRouter HTTP-Referer header)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Judge0 (required for real code grading)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_or_rapidapi_key
# Optional RapidAPI-only override:
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Admin question import (optional)
SAIT_ADMIN_IMPORT_KEY=
